    {
      "name": "06 - Incremental Cursor Pull",
      "item": [
        {
          "name": "Pull Updated Inspections Since Cursor",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/collections/inspections/records?filter=(updated>='{{cursor}}')&sort=updated,id&perPage=200",
              "host": ["{{baseUrl}}"],
              "path": ["api", "collections", "inspections", "records"],
              "query": [
                {
                  "key": "filter",
                  "value": "(updated>='{{cursor}}')"
                },
                {
                  "key": "sort",
                  "value": "updated,id"
                },
                {
                  "key": "perPage",
                  "value": "200"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Cursor pull returns paginated records\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.page).to.eql(1);",
                  "    if (data.items.length > 0) {",
                  "        var latest = data.items[data.items.length - 1].updated;",
                  "        pm.collectionVariables.set(\"cursor\", latest);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
