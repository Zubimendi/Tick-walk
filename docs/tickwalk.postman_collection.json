      "item": [
        {
          "name": "Service Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Health response code is 200\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.code).to.eql(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Authenticate Inspector (Get Token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identity\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/collections/users/auth-with-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "collections", "users", "auth-with-password"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns valid JWT token and user record\", function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.token).to.be.a(\"string\");",
                  "    pm.expect(data.record.id).to.be.a(\"string\");",
                  "    pm.collectionVariables.set(\"authToken\", data.token);",
                  "    pm.collectionVariables.set(\"userId\", data.record.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
